# /etc/systemd/system/livekit-agent@.service
[Unit]
Description=LiveKit Agent (instance %i)
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/etc/livekit-agent.env
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple

# App env (LIVEKIT_URL, keys, etc.)
EnvironmentFile=/etc/livekit-agent.env

# Sensible defaults (overridable via drop-in 10-env.conf)
Environment=APP_PORT=8081
Environment=HEALTH_CHECK_PORT=8080
Environment=CONTAINER_NAME=livekit-agent-%i

# Wait for Docker, optional registry login, robust pull with retries, fallback to cached image
ExecStartPre=/bin/bash -lc 'set -euo pipefail; \
  for i in {1..30}; do docker info >/dev/null 2>&1 && break || sleep 1; done; \
  img="${DOCKER_IMAGE:?DOCKER_IMAGE not set}"; \
  if [ -n "${DOCKER_USERNAME:-}" ] && [ -n "${DOCKER_PASSWORD:-}" ]; then \
    echo "$DOCKER_PASSWORD" | docker login -u "${DOCKER_USERNAME}" --password-stdin || true; \
  fi; \
  ok=""; for i in 1 2 3 4 5; do \
    docker pull "$img" && ok="y" && break || { echo "docker pull failed (try $i)"; sleep $((i*i)); }; \
  done; \
  [ -n "$ok" ] || docker image inspect "$img" >/dev/null'

# Clean any previous container (ignore errors)
ExecStartPre=-/usr/bin/docker rm -f ${CONTAINER_NAME}

# Run container (host APP_PORT -> container APP_PORT, health check port)
ExecStart=/usr/bin/docker run \
  --name ${CONTAINER_NAME} \
  --rm \
  --env-file /etc/livekit-agent.env \
  -p ${APP_PORT}:${APP_PORT} \
  -p ${HEALTH_CHECK_PORT}:${HEALTH_CHECK_PORT} \
  --add-host=host.docker.internal:host-gateway \
  --health-cmd="curl -f http://localhost:${HEALTH_CHECK_PORT}/health || exit 1" \
  --health-interval=30s \
  --health-timeout=10s \
  --health-start-period=60s \
  --health-retries=3 \
  --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
  ${DOCKER_IMAGE}

# Graceful stop + cleanup
ExecStop=/usr/bin/docker stop -t 30 ${CONTAINER_NAME}
ExecStopPost=-/usr/bin/docker rm -f ${CONTAINER_NAME}

# Keep it alive but avoid restart storms
Restart=always
RestartSec=5
TimeoutStartSec=0
KillMode=control-group
KillSignal=SIGTERM
LimitNOFILE=65536
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
