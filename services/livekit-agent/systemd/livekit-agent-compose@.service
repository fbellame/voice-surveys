# /etc/systemd/system/livekit-agent-compose@.service
[Unit]
Description=LiveKit Agent with DataDog Monitoring (instance %i)
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/etc/livekit-agent.env
ConditionPathExists=/etc/datadog.env
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes

# App env (LIVEKIT_URL, keys, etc.)
EnvironmentFile=/etc/livekit-agent.env
EnvironmentFile=/etc/datadog.env

# Sensible defaults (overridable via drop-in 10-env.conf)
Environment=APP_PORT=8081
Environment=HEALTH_CHECK_PORT=8080
Environment=INSTANCE=%i
Environment=DD_SITE=us5.datadoghq.com
Environment=DD_ENV=dev

# Working directory for docker-compose
WorkingDirectory=/opt/livekit-agent

# Create monitoring network if it doesn't exist
ExecStartPre=/usr/bin/docker network create monitoring || true

# Wait for Docker, optional registry login, robust pull with retries
ExecStartPre=/bin/bash -lc 'set -euo pipefail; \
  for i in {1..30}; do docker info >/dev/null 2>&1 && break || sleep 1; done; \
  img="${DOCKER_IMAGE:?DOCKER_IMAGE not set}"; \
  if [ -n "${DOCKER_USERNAME:-}" ] && [ -n "${DOCKER_PASSWORD:-}" ]; then \
    echo "$DOCKER_PASSWORD" | docker login -u "${DOCKER_USERNAME}" --password-stdin || true; \
  fi; \
  ok=""; for i in 1 2 3 4 5; do \
    docker pull "$img" && ok="y" && break || { echo "docker pull failed (try $i)"; sleep $((i*i)); }; \
  done; \
  [ -n "$ok" ] || docker image inspect "$img" >/dev/null'

# Start the services
ExecStart=/usr/local/bin/docker-compose up -d

# Stop the services
ExecStop=/usr/local/bin/docker-compose down

# Keep it alive but avoid restart storms
Restart=always
RestartSec=5
TimeoutStartSec=300
KillMode=control-group
KillSignal=SIGTERM
LimitNOFILE=65536
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
